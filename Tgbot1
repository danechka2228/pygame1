import random
images = ['AtonOgur1.jpg', 'rkn.jpg', 'traktor.jpg']

class Menu(Screen):
    def __init__(self, **kw):
        super(Menu, self).__init__(**kw)

        main_layout = BoxLayout(orientation='vertical')
        #1
        lin1 = BoxLayout(orientation='horizontal')
        btn1 = Button(text='', background_normal='AtonOgur1.jpg')
        btn1.bind(on_press=self.go_to_random)
        lin1.add_widget(btn1)
        lin1.add_widget(Label(text="Антоша ты такой хароший"))
        main_layout.add_widget(lin1)
        #2
        lin2 = BoxLayout(orientation='horizontal')
        btn2 = Button(text='', background_normal='rkn.jpg')
        btn2.bind(on_press=self.go_to_random)
        lin2.add_widget(btn2)
        lin2.add_widget(Label(text="Какашка"))
        main_layout.add_widget(lin2)
        #3
        lin3 = BoxLayout(orientation='horizontal')
        btn3 = Button(text='', background_normal='traktor.jpg')
        btn3.bind(on_press=self.go_to_random)
        lin3.add_widget(btn3)
        lin3.add_widget(Label(text="Антоша в эльдорадо"))
        main_layout.add_widget(lin3)
        self.add_widget(main_layout)


    def go_to_random(self, instance):
        random_image = random.choice(images)
        self.manager.get_screen('random').image_button.background_normal = random_image
        self.manager.current = 'random'

class Random(Screen):
    def __init__(self, **kw):
        super(Random, self).__init__(**kw)
        layout = BoxLayout(orientation='vertical')
        self.image_button = Button(text='')
        layout.add_widget(self.image_button)
        back_btn = Button(text='Назад')
        back_btn.bind(on_press=self.go_back)
        layout.add_widget(back_btn)
        self.add_widget(layout)

    def go_back(self, instance):
        self.manager.current = 'menu'

class MyApp(App):
    def build(self):
        sm = ScreenManager()
        sm.add_widget(Menu(name='menu'))
        sm.add_widget(Random(name='random'))
        return sm

if __name__ == '__main__':
    MyApp().run()



import sqlite3
from kivy.app import App
from kivy.lang import Builder
from kivy.uix.screenmanager import Screen
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.popup import Popup
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.properties import BooleanProperty, StringProperty, NumericProperty
from datetime import datetime

def db_query(sql, params=()):
    with sqlite3.connect('users.db') as conn:
        return conn.execute(sql, params).fetchall()

def pop(title, text):
    btn = Button(text="OK", size_hint_y=0.4)
    content = BoxLayout(orientation='vertical', padding=10)
    content.add_widget(Label(text=text))
    content.add_widget(btn)
    p = Popup(title=title, content=content, size_hint=(0.7, 0.3))
    btn.bind(on_release=p.dismiss)
    p.open()

class NoteItem(BoxLayout):
    selected = BooleanProperty(False)
    note_id = NumericProperty(0)
    note_text = StringProperty("")
    note_date = StringProperty("")

    def on_touch_down(self, touch):
        if self.collide_point(*touch.pos):
            for c in self.parent.children:
                if isinstance(c, NoteItem): c.selected = False
            self.selected = True
            return True
        return super().on_touch_down(touch)

class LoginScreen(Screen):
    def auth(self, l, p, reg=False):
        if not l or not p: return pop("Ошибка", "Сначала введите текст")
        if reg:
            try:
                db_query("INSERT INTO users VALUES (?,?)", (l, p))
                pop("Успех", "Пользователь зарегистрирован")
            except: pop("Ошибка", "Такой пользователь уже существует")
        elif db_query("SELECT * FROM users WHERE username=? AND password=?", (l, p)):
            self.manager.current = 'menu'
            self.manager.get_screen('menu').load()
        else: pop("Ошибка", "Неверные данные")

class Menu1(Screen):
    def load(self):
        self.ids.list.clear_widgets()
        for n in db_query("SELECT id, text, date FROM notes ORDER BY id DESC"):
            self.ids.list.add_widget(NoteItem(note_id=n[0], note_text=str(n[1]), note_date=str(n[2])))

    def add(self, text):
        if not text: return pop("Ошибка", "Сперва введите текст")
        db_query("INSERT INTO notes (text, date) VALUES (?,?)", (text, datetime.now().strftime("%H:%M")))
        self.ids.inp.text = ""
        self.load()

    def delete(self, all=False):
        if not self.ids.list.children:
            return pop("Ошибка", "Заметок нету")

        if all:
            db_query("DELETE FROM notes")
            pop("Успех", "Все удалено")
        else:
            found = False
            for c in self.ids.list.children:
                if getattr(c, 'selected', False):
                    db_query("DELETE FROM notes WHERE id=?", (c.note_id,))
                    found = True
                    break
            if not found:
                return pop("Ошибка", "Сперва выберите заметку")
        self.load()

class AuthApp(App):
    def build(self):
        db_query("CREATE TABLE IF NOT EXISTS users (username TEXT UNIQUE, password TEXT)")
        db_query("CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, text TEXT, date TEXT)")
        return Builder.load_string('''
