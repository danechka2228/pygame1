import telebot
import requests
from deep_translator import GoogleTranslator

# Твои ключи
TG_TOKEN = '8639395319:AAFWp1gOKq4u2cLX_niE6HnegTbk8ckLr7w'
OMDB_API_KEY = '23211341'

bot = telebot.TeleBot(TG_TOKEN)

@bot.message_handler(commands=['start'])
def start_command(message):
    bot.reply_to(message, 'Привет! я могу найти фильмы, просто введи их название!')

# Функция для удобного перевода
def translate_text(text, target_lang):
    try:
        return GoogleTranslator(source='auto', target=target_lang).translate(text)
    except:
        return text


@bot.message_handler(content_types=['text'])
def get_text_messages(message):
    movie_name_en = translate_text(message.text, 'en')

    url = "http://omdbapi.com"
    query_params = {
        't': movie_name_en,
        'apikey': OMDB_API_KEY
    }

    try:
        response = requests.get(url, params=query_params)
        data = response.json()

        if data.get('Response') == 'True':
            title = data.get('Title')
            year = data.get('Year')
            rating = data.get('imdbRating')
            plot_en = data.get('Plot')
            poster = data.get('Poster')


            plot_ru = translate_text(plot_en, 'ru')

            answer = (f"*{title}* ({year})\n"
                      f"Рейтинг IMDb: {rating}\n\n"
                      f"Описание: {plot_ru}")

            if poster and poster != 'N/A':
                bot.send_photo(message.chat.id, poster, caption=answer, parse_mode='Markdown')
            else:
                bot.send_message(message.chat.id, answer, parse_mode='Markdown')
        else:
            bot.send_message(message.chat.id, "Фильм не найден.")

    except Exception as e:
        print(f"Ошибка: {e}")
        bot.send_message(message.chat.id, "Ошибка при поиске.")


if __name__ == "__main__":
    bot.polling(none_stop=True)
